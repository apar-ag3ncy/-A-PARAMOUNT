{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "paramount-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "env": {
        "WATCHPACK_POLLING": "true",
        "CHOKIDAR_USEPOLLING": "true",
        "CHOKIDAR_INTERVAL": "300"
      }
    },
    {
      "name": "paramount-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    }
  ]
}
