# Copy to .env.local and fill in. The site runs fully on the local catalog and a
# mailto fallback until these are set — nothing breaks when they're blank.

# --- Sanity CMS (Prompt B) — enables live content + the /studio editor ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Resend (Prompt H) — enables the contact form to send email ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=aparamount1968@gmail.com
CONTACT_FROM_EMAIL=Paramount Website <onboarding@resend.dev>
